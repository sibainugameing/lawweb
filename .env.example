# LawGitのデータリポジトリ（laws/ と rules/ を含むディレクトリ）
LAWGIT_REPO=
LAWGIT_BIN=lawgit

# ローカルLawGit API
LAWGIT_API_HOST=127.0.0.1
LAWGIT_API_PORT=8787
LAWGIT_TOKEN=
LAWGIT_TIMEOUT=10

# LawWeb（0.0.0.0: 同じプライベートLANから接続可能 / 127.0.0.1: このPCのみ）
WEB_HOST=0.0.0.0
WEB_PORT=5000

# 任意。空欄ならinstance/secret.keyを自動生成（推奨）
LAWWEB_SECRET_KEY=
LAWWEB_SESSION_HOURS=8
LAWWEB_IDLE_MINUTES=30
