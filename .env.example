# LawGitのデータリポジトリ（laws/ と rules/ を含むディレクトリ）の絶対パスを指定
LAWGIT_REPO=

# lawgit コマンド。PATHにない場合は絶対パスに変更
LAWGIT_BIN=lawgit

# LawGit HTTP API
LAWGIT_API_HOST=127.0.0.1
LAWGIT_API_PORT=8787
LAWGIT_API_URL=http://127.0.0.1:8787
LAWGIT_TOKEN=
LAWGIT_TIMEOUT=15

# 起動時にLawGitの書き込みを自動コミットする場合だけ1にする
LAWGIT_COMMIT=0

# Web UI（認証機能はないため、127.0.0.1のまま使用すること）
WEB_HOST=127.0.0.1
WEB_PORT=5000
